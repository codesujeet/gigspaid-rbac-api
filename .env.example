# Copy to .env for local development:  cp .env.example .env

# Secret used to sign JWTs (HS256). REQUIRED when NODE_ENV=production
# (the server refuses to start without it, with fewer than 32 characters,
# or with an obvious placeholder / repetitive value).
# In development/test a random per-process secret is generated if this is unset,
# which means tokens stop working whenever the server restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetime (jsonwebtoken / ms format: 15m, 1h, 7d ...)
JWT_EXPIRES_IN=1h

PORT=3000
NODE_ENV=development

# bcrypt cost factor (4-15). 10-12 is typical for production.
BCRYPT_ROUNDS=10

# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the app (0 = none). Needed so the login
# rate limiter sees real client IPs behind a proxy; leave 0 when exposed directly.
TRUST_PROXY_HOPS=0

# Demo seed users are created on startup. Set to "false" to disable
# (always disabled by default in production unless SEED_DEMO_USERS=true).
SEED_DEMO_USERS=true
